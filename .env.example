# MT5 EA Platform — Environment Configuration
# Copy this to .env and fill in your values

# API Authentication (generated by: python main.py --setup-key)
API_KEY_HASH=

# JWT Secret (auto-generated on first run if empty)
JWT_SECRET=

# Server
HOST=0.0.0.0
PORT=8000

# MT5 Paths (auto-detected if empty; set manually to override)
TERMINAL_PATH=
METAEDITOR_PATH=
MQL5_ROOT=

# Workspace Directories
WORKSPACE_DIR=workspace
EXPORTS_DIR=exports

# Database
DB_PATH=platform.db
